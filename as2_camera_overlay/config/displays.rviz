Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: world_grid
      Enabled: true
      Reference Frame: "<Fixed Frame>"
      Plane Cell Count: 25
      Cell Size: 1.0
      Color: 128; 128; 128
      Alpha: 0.5

    - Class: rviz_default_plugins/MarkerArray
      Name: gates_static
      Enabled: true
      Topic: /gates_static

    - Class: rviz_default_plugins/MarkerArray
      Name: gates_tracking
      Enabled: true
      Topic: /gates_tracking
      Namespaces:
        gate_status: true

    - Class: rviz_default_plugins/TF
      Name: tf_axes
      Enabled: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
